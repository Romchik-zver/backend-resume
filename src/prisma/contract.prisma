
model Skill {
  id Int @id @default(autoincrement())
  profile Profile @relation(fields: [profileId], references: [id])
  profileId Int
  name String
  level String
}
model Experience {
  id Int @id @default(autoincrement())
  profile Profile @relation(fields: [profileId], references: [id])
  profileId Int
  company String
  position String
  period String
  achievements String
}

model Project{
  id Int @id @default(autoincrement())
  profile Profile @relation(fields: [profileId], references: [id])
  profileId Int
  name String
  idea String
  repoUrl String
  stack String
}

model Profile {
  id Int @id @default(autoincrement())
  name String
  description String
  skills Skill[]
  experience Experience[]
  projects Project[]
  githubUrl String
  linkedinUrl String
}
